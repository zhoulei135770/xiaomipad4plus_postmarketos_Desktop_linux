#!/sbin/sh
# TWRP restore script for Xiaomi Mi Pad 4 Plus (clover) - postmarketOS
#
# Layout (device keeps its Android partition table):
#   boot        -> boot.img (kernel + dtb + cmdline)
#   userdata    -> ext4 rootfs (pmOS), usually /dev/mmcblk1p64
#
# IMPORTANT: everything is streamed.  TWRP's /tmp is a RAM-backed tmpfs
# (~2 GB on this device) and the rootfs is ~2.6 GB, so extracting to /tmp
# would always fail.  `unzip -p ... | tar -xz -C /data` keeps memory use flat.
set -u

OUTFD=/proc/self/fd/$2
ui_print() { echo "ui_print $1" > "$OUTFD"; echo "ui_print" > "$OUTFD"; }
abort() { ui_print "! $1"; exit 1; }

ZIP=$3
ui_print "==== clover postmarketOS restore ===="

# ---------------------------------------------------------------- partitions
BOOT=""
for c in boot boot_a; do
	[ -e "/dev/block/bootdevice/by-name/$c" ] && BOOT="/dev/block/bootdevice/by-name/$c" && break
done
[ -n "$BOOT" ] || abort "boot partition not found"

USERDATA=""
for c in userdata; do
	[ -e "/dev/block/bootdevice/by-name/$c" ] && USERDATA="/dev/block/bootdevice/by-name/$c" && break
done
[ -n "$USERDATA" ] || USERDATA=/dev/block/mmcblk1p64

ui_print "boot     : $BOOT"
ui_print "userdata : $USERDATA"

# ---------------------------------------------------------------- 1. boot.img
ui_print "Checking boot.img in the zip ..."
unzip -l "$ZIP" boot.img >/dev/null 2>&1 || abort "boot.img missing in zip"
ui_print "Flashing boot.img ..."
# stream straight to the partition (no /tmp copy)
unzip -p "$ZIP" boot.img | dd of="$BOOT" bs=1M || abort "dd boot failed"
ui_print "boot.img flashed"

# ---------------------------------------------------------------- 2. rootfs
ui_print "Mounting userdata ..."
mkdir -p /data
mountpoint -q /data || mount -t ext4 -o rw "$USERDATA" /data 2>/dev/null
mountpoint -q /data || abort "cannot mount userdata"

ui_print "Extracting rootfs (streamed, ~2.6 GB, be patient) ..."
rm -rf /data/lost+found 2>/dev/null
unzip -p "$ZIP" rootfs.tar.gz | tar -xz -C /data --numeric-owner || abort "extract failed"
ui_print "rootfs extracted"

# ---------------------------------------------------------------- 3. tidy
chown 0:0 /data 2>/dev/null
chmod 755 /data 2>/dev/null
sync
ui_print "sync done"

ui_print "==== finished: reboot to system ===="
exit 0
