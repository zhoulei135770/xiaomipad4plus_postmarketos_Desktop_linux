#!/usr/bin/env python3
"""pad_als.py - read the ambient light sensor (Capella CM3232) via IIO.

The sensor manager reports the CM3232 under the combined PROX_LIGHT type, so it
appears either as "qcom-smgr-prox" (mainline naming) or "qcom-smgr-light" (the
optional illuminance-named variant).  Both are buffer-only: there is no
in_illuminance_raw / in_proximity_raw, so a sample is taken by enabling the scan
elements and reading the character device.

    sudo pad_als.py            # one sample
    sudo pad_als.py 5          # five samples
"""
import os
import struct
import sys
import time

IIO = "/sys/bus/iio/devices"
NAMES = ("qcom-smgr-light", "qcom-smgr-prox")
REC = 16          # u32 value at offset 0, s64 timestamp at offset 8


def find():
    for want in NAMES:
        for d in sorted(os.listdir(IIO)):
            p = os.path.join(IIO, d)
            try:
                with open(os.path.join(p, "name")) as f:
                    if f.read().strip() == want:
                        return p, d, want
            except OSError:
                continue
    return None, None, None


def write(path, val):
    with open(path, "w") as f:
        f.write(str(val))


def main():
    n = int(sys.argv[1]) if len(sys.argv) > 1 else 1
    path, dev, name = find()
    if not path:
        print("no CM3232 device (looked for %s)" % ", ".join(NAMES))
        return 1

    se = os.path.join(path, "scan_elements")
    if os.path.exists(os.path.join(se, "in_illuminance_en")):
        elem = "in_illuminance_en"
    elif os.path.exists(os.path.join(se, "in_proximity_en")):
        elem = "in_proximity_en"
    else:
        print(f"no usable scan element in {se}")
        return 1

    try:
        write(os.path.join(path, "buffer", "enable"), 0)
    except OSError:
        pass
    time.sleep(0.2)
    write(os.path.join(se, elem), 1)
    write(os.path.join(se, "in_timestamp_en"), 1)
    write(os.path.join(path, "buffer", "length"), 8)
    write(os.path.join(path, "buffer", "enable"), 1)
    time.sleep(0.4)

    fd = os.open(f"/dev/{dev}", os.O_RDONLY)
    try:
        for i in range(n):
            data = os.read(fd, REC)
            if len(data) < REC:
                print("short read")
                break
            val, = struct.unpack_from("<I", data, 0)
            ts, = struct.unpack_from("<q", data, 8)
            print(f"sample {i + 1}: illuminance_raw={val}  ts={ts}  ({name})")
            time.sleep(0.2)
    finally:
        os.close(fd)
        try:
            write(os.path.join(path, "buffer", "enable"), 0)
            write(os.path.join(se, elem), 0)
            write(os.path.join(se, "in_timestamp_en"), 0)
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
