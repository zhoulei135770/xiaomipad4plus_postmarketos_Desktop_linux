#!/bin/sh
# Try an immediate capture repeatedly for N seconds; keep the first frame that
# the sensor actually produces and analyse it.
D=/sys/bus/spi/devices/spi0.0
SECS=${1:-60}
OUT=/tmp/fpimg.bin
END=$(( $(date +%s) + SECS ))

: > "$OUT"
dmesg -c >/dev/null 2>&1

got=0
while [ "$(date +%s)" -lt "$END" ]; do
	echo 1 > "$D/capture_now" 2>/dev/null
	sleep 1
	sz=$(wc -c < "$D/image" 2>/dev/null)
	if [ -n "$sz" ] && [ "$sz" -gt 1000 ] 2>/dev/null; then
		got=1
		break
	fi
done

{
	echo "=== got=$got ==="
	dmesg | grep -E "capture_now|captured|status" | tail -6
} > /tmp/fpimg.log 2>&1

if [ "$got" = "1" ]; then
	off=0
	: > "$OUT"
	while :; do
		dd if="$D/image" of=/tmp/fpchunk.bin bs=1 skip=$off count=4096 2>/dev/null
		sz=$(wc -c < /tmp/fpchunk.bin 2>/dev/null)
		[ -z "$sz" ] && break
		[ "$sz" -eq 0 ] && break
		cat /tmp/fpchunk.bin >> "$OUT"
		off=$((off + sz))
		[ "$off" -ge 12000 ] && break
	done
	{
		echo "=== image bytes: $(wc -c < "$OUT") ==="
		echo "--- first 64 bytes (u8) ---"
		od -An -tu1 -N 64 "$OUT"
		echo "--- last 32 bytes (u8) ---"
		tail -c 32 "$OUT" | od -An -tu1
		echo "--- histogram buckets (body) ---"
		tail -c +3 "$OUT" | od -An -tu1 -v | tr ' ' '\n' | grep -E '^[0-9]+$' |
			awk '{ if ($1<32) a++; else if ($1<64) b++; else if ($1<96) c++;
			       else if ($1<128) d++; else if ($1<160) e++;
			       else if ($1<192) f++; else if ($1<224) g++; else h++ }
			     END { printf "  0-31:%d 32-63:%d 64-95:%d 96-127:%d 128-159:%d 160-191:%d 192-223:%d 224-255:%d\n", a,b,c,d,e,f,g,h }'
	} >> /tmp/fpimg.log 2>&1
fi
