#!/usr/bin/env python3
"""pad_peek.py - read physical memory through /dev/mem (root only).

    sudo pad_peek.py 0xa800400 [count]

Useful for inspecting the xHCI port registers, which expose the raw
electrical state of the USB port (connect status, port power, etc.).
"""
import mmap
import os
import struct
import sys

PAGE = 4096


def read32(addr, count=1):
    base = addr & ~(PAGE - 1)
    off = addr - base
    length = ((off + 4 * count + PAGE - 1) // PAGE) * PAGE
    fd = os.open("/dev/mem", os.O_RDONLY | os.O_SYNC)
    try:
        m = mmap.mmap(fd, length, mmap.MAP_SHARED, mmap.PROT_READ)
        try:
            return [struct.unpack_from("<I", m, off + 4 * i)[0]
                    for i in range(count)]
        finally:
            m.close()
    finally:
        os.close(fd)


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        return 1
    addr = int(sys.argv[1], 0)
    count = int(sys.argv[2]) if len(sys.argv) > 2 else 1
    try:
        vals = read32(addr, count)
    except Exception as e:                      # noqa: BLE001
        print("read failed: %s" % e)
        return 1
    for i, v in enumerate(vals):
        print("0x%08x = 0x%08x" % (addr + 4 * i, v))
    return 0


if __name__ == "__main__":
    sys.exit(main())
