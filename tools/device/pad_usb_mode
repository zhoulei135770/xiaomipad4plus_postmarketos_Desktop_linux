#!/bin/sh
# pad_usb_mode.sh - switch the USB-C port between charging and USB-host use.
#
# The PM660L SMB2 charger cannot charge while its OTG boost is enabled: the
# boost drives 5 V onto the port, the charger sees its own output instead of an
# external charger, and usb_online stays 0.  Measured:
#
#   otg_vbus=1 -> usbin_v 5.06 V (our boost), charger online=0, current -1.3 A
#   otg_vbus=0 -> usbin_v 4.98 V (the charger),  charger online=1, current +362 mA
#
# So it is one or the other, and the default must be "charge".
#
#   pad_usb_mode charge   OTG boost off, the port charges from an adapter
#   pad_usb_mode host     OTG boost on, the port powers a hub / USB devices
#   pad_usb_mode status   report the current mode and charging state
set -e

OTG=$(find /sys/devices -name otg_vbus 2>/dev/null | head -1)
[ -n "$OTG" ] || { echo "otg_vbus attribute not found"; exit 1; }

status() {
	echo "  otg_vbus    = $(cat "$OTG" 2>/dev/null)"
	echo "  charger     = $(cat /sys/class/power_supply/pm660-charger/status 2>/dev/null)"
	echo "  online      = $(cat /sys/class/power_supply/pm660-charger/online 2>/dev/null)"
	echo "  battery     = $(cat /sys/class/power_supply/qcom-battery/status 2>/dev/null) $(cat /sys/class/power_supply/qcom-battery/capacity 2>/dev/null)%"
	echo "  current_now = $(cat /sys/class/power_supply/qcom-battery/current_now 2>/dev/null) uA"
	for d in /sys/bus/usb/devices/*/; do
		n=$(basename "$d")
		case "$n" in usb*|*-0:1.0) continue ;; esac
		p=$(cat "$d/product" 2>/dev/null)
		[ -n "$p" ] && echo "  usb: $n $p"
	done
}

case "$1" in
charge)
	echo off > "$OTG"
	sleep 1
	echo "USB port: charging mode (OTG boost off)"
	status
	;;
host)
	echo on > "$OTG"
	sleep 1
	echo "USB port: host mode (OTG boost on, charging disabled)"
	status
	;;
status|"")
	echo "USB port status:"
	status
	;;
*)
	echo "usage: pad_usb_mode {charge|host|status}"
	exit 1
	;;
esac
