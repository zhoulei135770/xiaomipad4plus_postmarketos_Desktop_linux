#!/bin/sh
# Watch for USB connect/disconnect events and report what enumerates.
# Run it, then plug the device in both Type-C orientations.
DUR=${1:-90}
END=$(( $(date +%s) + DUR ))
last=""
: > /tmp/usbwatch.log

while [ "$(date +%s)" -lt "$END" ]; do
	now=$(ls /sys/bus/usb/devices/ 2>/dev/null | tr '\n' ' ')
	if [ "$now" != "$last" ]; then
		echo "=== $(date +%H:%M:%S) devices: $now" >> /tmp/usbwatch.log
		for d in /sys/bus/usb/devices/*/; do
			n=$(basename "$d")
			p=$(cat "$d/product" 2>/dev/null)
			v=$(cat "$d/idVendor" 2>/dev/null)
			[ -n "$p" ] && echo "    $n  $v  $p" >> /tmp/usbwatch.log
		done
		last="$now"
	fi
	sleep 1
done

echo "=== dmesg ===" >> /tmp/usbwatch.log
dmesg | grep -iE "usb [0-9]-|new .* device|usb.*disconnect|hub" | tail -15 >> /tmp/usbwatch.log
echo "done" >> /tmp/usbwatch.log
