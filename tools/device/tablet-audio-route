#!/bin/sh
# Route MultiMedia playback to the primary MI2S, where the two TAS2557
# smart amplifiers sit, and leave the analog codec path alone.
i=0
while [ ! -e /proc/asound/card0 ] && [ $i -lt 60 ]; do
    sleep 1
    i=$((i + 1))
done
[ -e /proc/asound/card0 ] || exit 0
amixer -c0 cset iface=MIXER,name='PRI_MI2S_RX Audio Mixer MultiMedia1' 1 >/dev/null 2>&1
amixer -c0 cset iface=MIXER,name='INT0_MI2S_RX Audio Mixer MultiMedia1' 0 >/dev/null 2>&1
amixer -c0 cset iface=MIXER,name='Left Speaker Playback Volume' 15 >/dev/null 2>&1
amixer -c0 cset iface=MIXER,name='Right Speaker Playback Volume' 15 >/dev/null 2>&1
exit 0
