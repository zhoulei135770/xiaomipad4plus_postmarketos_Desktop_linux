#!/usr/bin/env python3
"""tablet-camera-gui - one-tap rear camera capture for the Mi Pad 4 Plus.

Tap "拍照": the helper `tablet-cam` runs the auto-exposure loop as root, the
RAW10 frame is converted here (numpy only, no Pillow) with a grey-world white
balance, saved to ~/Pictures and shown in the window.

The capture is slow (a few seconds: several frames + AE), so it runs in a
worker thread and the UI stays responsive.
"""
import os
import subprocess
import threading
import time
import zlib

import gi
import numpy as np

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk, GdkPixbuf  # noqa: E402

W, H = 4224, 3136
FRAME = W * H * 10 // 8
RAW = "/tmp/gui-photo.raw"
PICS = os.path.expanduser("~/Pictures")


# ---------------------------------------------------------------- PNG writer
def png_bytes(rgb):
    """Encode an HxWx3 uint8 array as PNG (RGB, filter 0)."""
    h, w, _ = rgb.shape
    raw = np.empty((h, 1 + w * 3), dtype=np.uint8)
    raw[:, 0] = 0
    raw[:, 1:] = rgb.reshape(h, w * 3)
    comp = zlib.compress(raw.tobytes(), 6)

    def chunk(tag, data):
        return (len(data).to_bytes(4, "big") + tag + data
                + (zlib.crc32(tag + data) & 0xFFFFFFFF).to_bytes(4, "big"))

    ihdr = (w.to_bytes(4, "big") + h.to_bytes(4, "big")
            + bytes([8, 2, 0, 0, 0]))
    return b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) + chunk(b"IDAT", comp) + chunk(b"IEND", b"")


def unpack_raw10(buf, w, h):
    groups = np.frombuffer(buf, dtype=np.uint8)[: (w * h // 4) * 5].reshape(-1, 5)
    out = np.empty((groups.shape[0], 4), dtype=np.uint16)
    for i in range(4):
        out[:, i] = (groups[:, i].astype(np.uint16) << 2) | ((groups[:, 4] >> (i * 2)) & 3)
    return out.reshape(h, w)


def raw_to_rgb(path):
    img = unpack_raw10(np.fromfile(path, dtype=np.uint8), W, H)
    h2, w2 = H // 2, W // 2
    r = img[0:2 * h2:2, 0:2 * w2:2].astype(np.float32)
    g = (img[0:2 * h2:2, 1:2 * w2:2] + img[1:2 * h2:2, 0:2 * w2:2]) / 2.0
    b = img[1:2 * h2:2, 1:2 * w2:2].astype(np.float32)
    rgb = np.stack([r, g, b], axis=-1)
    lo, hi = np.percentile(rgb, 0.5), np.percentile(rgb, 99.5)
    rgb = np.clip((rgb - lo) * 255.0 / max(1.0, hi - lo), 0, 255)
    m = rgb.reshape(-1, 3).mean(axis=0)
    if min(m) > 1e-3:
        rgb = np.clip(rgb * (m.mean() / m), 0, 255)
    return rgb.astype(np.uint8)


# ------------------------------------------------------------------ the GUI
class Cam(Gtk.Window):
    def __init__(self):
        super().__init__(title="平板相机")
        self.set_default_size(900, 700)
        self.set_border_width(8)
        self.busy = False

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.add(vbox)

        self.pic = Gtk.Image()
        self.pic.set_size_request(880, 560)
        vbox.pack_start(self.pic, True, True, 0)

        self.status = Gtk.Label(label="点“拍照”开始（约 5 秒，需要几帧自动曝光）")
        self.status.set_xalign(0)
        vbox.pack_start(self.status, False, False, 0)

        row = Gtk.Box(spacing=8)
        self.btn = Gtk.Button(label="拍照")
        self.btn.set_size_request(-1, 56)
        self.btn.connect("clicked", self.on_shoot)
        row.pack_start(self.btn, True, True, 0)
        gal = Gtk.Button(label="打开相册")
        gal.set_size_request(-1, 56)
        gal.connect("clicked", lambda *_: subprocess.Popen(["xdg-open", PICS]))
        row.pack_start(gal, False, False, 0)
        vbox.pack_start(row, False, False, 0)

        os.makedirs(PICS, exist_ok=True)
        self.connect("destroy", Gtk.main_quit)

    def on_shoot(self, *_):
        if self.busy:
            return
        self.busy = True
        self.btn.set_sensitive(False)
        self.status.set_text("拍摄中…（自动曝光大概 5 秒）")
        threading.Thread(target=self.work, daemon=True).start()

    def work(self):
        try:
            r = subprocess.run(["sudo", "-n", "/usr/local/bin/tablet-cam", RAW, "--iters", "4"],
                               capture_output=True, text=True, timeout=120)
            log = (r.stdout or "").strip().splitlines()
            if not os.path.exists(RAW) or os.path.getsize(RAW) != FRAME:
                GLib.idle_add(self.done, False, "拍摄失败：" + (log[-1] if log else r.stderr[:80]))
                return
            rgb = raw_to_rgb(RAW)
            path = os.path.join(PICS, time.strftime("photo-%Y%m%d-%H%M%S.png"))
            with open(path, "wb") as f:
                f.write(png_bytes(rgb))
            GLib.idle_add(self.done, True, path)
        except Exception as exc:                      # noqa: BLE001
            GLib.idle_add(self.done, False, f"出错：{exc}")

    def done(self, ok, payload):
        self.busy = False
        self.btn.set_sensitive(True)
        if ok:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(payload, 880, 560, True)
            self.pic.set_from_pixbuf(pb)
            self.status.set_text(f"已保存：{payload}")
        else:
            self.status.set_text(payload)
        return False


def main():
    win = Cam()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
