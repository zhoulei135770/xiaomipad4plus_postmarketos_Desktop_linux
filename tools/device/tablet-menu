#!/bin/sh
# 应用菜单：打开 LXQt 面板的原生应用菜单（点击别处会自动关闭）。
#
# 以前这里用 jgmenu_run，但它在 labwc/Wayland 下弹出的是独立 surface，
# 点击其它位置不会消失，只能被强行 kill。
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/10000}
export DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/10000/bus}
export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0}
export QT_QPA_PLATFORM=wayland
exec /usr/bin/lxqt-qdbus openmenu
